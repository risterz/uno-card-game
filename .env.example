# ==============================================================================
# UNO Production Environment Configuration Template
# (Placeholder values only. Never commit real secrets or production credentials)
# ==============================================================================

# ------------------------------------------------------------------------------
# FRONTEND CONFIGURATION (Cloudflare Pages)
# ------------------------------------------------------------------------------
# Production URL of your deployed Render backend (Node + Socket.IO)
# Example: https://uno-multiplayer-backend.onrender.com
VITE_SERVER_URL=https://your-uno-backend.onrender.com

# ------------------------------------------------------------------------------
# BACKEND CONFIGURATION (Render Web Service)
# ------------------------------------------------------------------------------
# Port for the Node.js server (Render automatically sets process.env.PORT, default: 4000)
PORT=4000

# Host binding address (Use 0.0.0.0 for containerized environments and Render)
HOST=0.0.0.0

# CORS Allowed Origin(s)
# Comma-separated list of allowed frontend origins, or wildcard *
# Cloudflare Pages domain format: https://<project>.pages.dev, https://*.pages.dev
CLIENT_URL=https://your-uno-app.pages.dev,http://localhost:3000

# Runtime environment
NODE_ENV=production
